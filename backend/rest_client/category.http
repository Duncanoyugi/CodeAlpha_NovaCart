##################################################
# NovaCart - Get All Existing Category IDs
# Run this to see all categories you've already created
##################################################

@baseUrl = http://127.0.0.1:8000/api/products

### Get All Categories - This will show all your existing categories with their IDs
GET {{baseUrl}}/categories/

